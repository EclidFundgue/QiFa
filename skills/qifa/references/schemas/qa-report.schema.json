{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QiFa QA report",
  "description": "自动质检报告：确定性检查 + 语义 rubric 结论 + 时长统计 + 降级清单。",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "mode", "summary", "items", "duration"],
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["production", "development"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockers", "warnings", "infos", "degradations"],
      "properties": {
        "blockers": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 },
        "degradations": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "rule_id", "severity", "stage", "target", "message", "remediation", "status"],
        "properties": {
          "layer": { "enum": ["structure", "source", "pedagogy", "chapter", "narrative", "visual", "web", "integration"] },
          "rule_id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "warning", "info"] },
          "stage": { "type": "string", "minLength": 1 },
          "target": { "type": "string" },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string" },
          "status": { "enum": ["open", "fixed", "degraded", "accepted"] }
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_chapter", "total"],
      "properties": {
        "per_chapter": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapter_id", "chars", "words", "minutes"],
            "properties": {
              "chapter_id": { "type": "string" },
              "chars": { "type": "integer", "minimum": 0 },
              "words": { "type": "integer", "minimum": 0 },
              "minutes": { "type": "number", "minimum": 0 }
            }
          }
        },
        "total": { "type": "number", "minimum": 0 }
      }
    }
  }
}
