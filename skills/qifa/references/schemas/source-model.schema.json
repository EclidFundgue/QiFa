{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QiFa source model",
  "description": "来源结构化模型：论文、代码库、媒体素材，以及论文与代码的相关性映射和术语表。",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "relevance", "glossary"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "mapping"],
      "properties": {
        "relation": { "enum": ["related", "partial", "none", "not-applicable"] },
        "mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paper_section", "code_paths", "notes"],
            "properties": {
              "paper_section": { "type": "string", "minLength": 1 },
              "code_paths": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "translation", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "translation": { "type": "string" },
          "definition": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "origin"],
      "properties": {
        "type": { "enum": ["paper", "repo", "media"] },
        "id": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/named_anchor" } },
        "figures": { "type": "array", "items": { "$ref": "#/$defs/named_anchor" } },
        "equations": { "type": "array", "items": { "$ref": "#/$defs/named_anchor" } },
        "tables": { "type": "array", "items": { "$ref": "#/$defs/named_anchor" } },
        "code": { "$ref": "#/$defs/code_model" },
        "notes": { "type": "string" }
      }
    },
    "named_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 }
      }
    },
    "code_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "entrypoints": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "dataflow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "notes"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
